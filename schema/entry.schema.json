{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MEGA-M1ND/AI-Code-Threat-Radar/main/schema/entry.schema.json",
  "title": "RADAR entry",
  "description": "One catalogued supply-chain threat in the AI coding agent ecosystem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "title",
    "summary",
    "indicators",
    "severity",
    "severity_rationale",
    "status",
    "first_seen",
    "last_updated",
    "sources",
    "affected_tools"
  ],
  "properties": {
    "id": {
      "description": "Stable RADAR identifier. Never reused, never renumbered.",
      "type": "string",
      "pattern": "^RADAR-[0-9]{4}-[0-9]{4}$"
    },
    "category": {
      "description": "What kind of threat this is. One entry has exactly one category.",
      "type": "string",
      "enum": [
        "malicious-skill",
        "slopsquat-package",
        "malicious-mcp-server",
        "malicious-package",
        "compromised-package",
        "platform-vuln",
        "vibe-app-breach"
      ]
    },
    "title": {
      "description": "Short human-readable name. Lead with the artifact name where one exists.",
      "type": "string",
      "minLength": 4,
      "maxLength": 120
    },
    "summary": {
      "description": "At most two factual sentences. What happened and what it did. No adjectives of praise or alarm.",
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "indicators": {
      "description": "Machine-matchable artifacts. Values are character-exact as published by the source.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/indicator"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "severity_rationale": {
      "description": "One line explaining the severity choice.",
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "status": {
      "description": "active: still reachable or unremediated. remediated: removed, patched or revoked. disputed: contested by an involved party.",
      "type": "string",
      "enum": [
        "active",
        "remediated",
        "disputed"
      ]
    },
    "first_seen": {
      "$ref": "#/$defs/date"
    },
    "last_updated": {
      "$ref": "#/$defs/date"
    },
    "sources": {
      "description": "Every entry carries at least one primary source: a vendor advisory, registry takedown notice, maintainer disclosure, or the original researcher writeup.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      },
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "primary"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 1
    },
    "affected_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "claude-code",
          "cursor",
          "codex-cli",
          "gemini-cli",
          "copilot",
          "generic-mcp",
          "other"
        ]
      }
    },
    "related": {
      "description": "External identifiers for the same incident. Cite, do not duplicate: RADAR does not restate CVE content.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|GHSA-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}|OSV-[0-9]{4}-[0-9]+|MAL-[0-9]{4}-[0-9]+)$"
      }
    }
  },
  "$defs": {
    "date": {
      "description": "ISO 8601 calendar date, UTC.",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "publisher",
        "type"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publisher": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        }
      }
    },
    "indicator": {
      "oneOf": [
        {
          "$ref": "#/$defs/indicator_package"
        },
        {
          "$ref": "#/$defs/indicator_application"
        },
        {
          "$ref": "#/$defs/indicator_mcp_server"
        },
        {
          "$ref": "#/$defs/indicator_skill"
        },
        {
          "$ref": "#/$defs/indicator_hash"
        },
        {
          "$ref": "#/$defs/indicator_domain"
        },
        {
          "$ref": "#/$defs/indicator_url"
        },
        {
          "$ref": "#/$defs/indicator_ip"
        }
      ]
    },
    "indicator_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "registry",
        "name"
      ],
      "properties": {
        "type": {
          "const": "package"
        },
        "registry": {
          "type": "string",
          "enum": [
            "npm",
            "pypi",
            "crates",
            "vscode"
          ]
        },
        "name": {
          "description": "Exact registry name. For vscode, the marketplace id: publisher.extension.",
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "version": {
          "description": "Affected version or range, verbatim from the source. Omit when the whole package is malicious.",
          "type": "string",
          "maxLength": 200
        },
        "affected": {
          "description": "Machine-comparable form of `version`, when the source states it unambiguously. `version` stays verbatim from the source and remains authoritative; this field is a convenience for tools and may be absent.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "versions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "maxLength": 60
              }
            },
            "ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "introduced": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "fixed": {
                    "description": "First version that is NOT affected.",
                    "type": "string",
                    "maxLength": 60
                  },
                  "last_affected": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              }
            }
          }
        }
      }
    },
    "indicator_mcp_server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "repo"
          ]
        }
      ],
      "properties": {
        "type": {
          "const": "mcp-server"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repo": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "indicator_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug"
      ],
      "properties": {
        "type": {
          "const": "skill"
        },
        "slug": {
          "description": "Marketplace identifier for the skill, e.g. author/skill-name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "marketplace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "indicator_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "algo",
        "value"
      ],
      "properties": {
        "type": {
          "const": "hash"
        },
        "algo": {
          "type": "string",
          "enum": [
            "md5",
            "sha1",
            "sha256",
            "sha512"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]+$"
        }
      }
    },
    "indicator_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "domain"
        },
        "value": {
          "description": "Bare hostname, lowercase, not defanged.",
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        }
      }
    },
    "indicator_url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "url"
        },
        "value": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "indicator_application": {
      "description": "A distributed application that is not published through one of the supported registries, such as an IDE.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "const": "application"
        },
        "name": {
          "description": "Lowercase product identifier, e.g. cursor.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "description": "Affected version or range, verbatim from the source.",
          "type": "string",
          "maxLength": 200
        },
        "affected": {
          "description": "Machine-comparable form of `version`, when the source states it unambiguously. `version` stays verbatim from the source and remains authoritative; this field is a convenience for tools and may be absent.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "versions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "maxLength": 60
              }
            },
            "ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "introduced": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "fixed": {
                    "description": "First version that is NOT affected.",
                    "type": "string",
                    "maxLength": 60
                  },
                  "last_affected": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              }
            }
          }
        }
      }
    },
    "indicator_ip": {
      "description": "A command-and-control or exfiltration address. Stored live, not defanged.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "ip"
        },
        "value": {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$|^[0-9a-f:]{3,45}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
